                "tickets",
                "{{ticketId}}",
                "status"
              ]
            },
            "description": "The note is saved as a public agent reply.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"WAITING_ON_CUSTOMER\",\n  \"note\": \"Could you confirm your delivery address is still correct?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
