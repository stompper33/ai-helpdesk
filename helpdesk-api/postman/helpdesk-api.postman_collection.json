              "path": [
                "api",
                "tickets",
                "{{ticketId}}",
                "triage"
              ]
            },
            "description": "This is the endpoint the AI triage agent will call in stage 2. Changing priority recalculates slaDueAt.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"SHIPPING\",\n  \"priority\": \"HIGH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
