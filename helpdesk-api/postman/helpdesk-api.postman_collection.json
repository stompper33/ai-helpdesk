    {
      "name": "2. Ticket lifecycle (run in order)",
      "description": "Walks one ticket from creation to closure. Each request saves/uses {{ticketId}}. Use the Collection Runner on this folder to run it end to end.",
      "item": [
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "Starts OPEN. The SLA deadline comes from priority and customer tier (premium = half the time).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 2,\n  \"orderNumber\": \"ORD-10004\",\n  \"subject\": \"Monitor order still not shipped\",\n  \"description\": \"I ordered a 4K monitor last week and it still says PLACED. Can you check on it?\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"ticketId\", t.id);",
                  "console.log(\"ticketId =\", t.id, \"status =\", t.status);",
                  "pm.test(\"Starts OPEN\", () => pm.expect(pm.response.json().status).to.eql(\"OPEN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
