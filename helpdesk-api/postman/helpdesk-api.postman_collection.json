{
  "info": {
    "name": "Helpdesk API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Stage 1 of the helpdesk + AI project. Start the app (mvn spring-boot:run) and run folders in order. Seed data resets on every restart."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "agentId",
      "value": "2"
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "newCustomerId",
      "value": ""
    }
  ],
  "item": [
