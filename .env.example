# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) to use.
# Your OpenAI key does NOT go here: it stays in ai-service/.env.

# Shared secret: Spring Boot sends it to ai-service as X-Api-Key.
# Postman calls straight to ai-service (port 8000) must send it too (collection variable aiApiKey).
SERVICE_API_KEY=local-dev-secret

# Local-only database credentials
DB_USER=helpdesk
DB_PASSWORD=helpdesk

# Local-only RabbitMQ credentials (management UI: http://localhost:15672)
RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=helpdesk

# Change if you already run PostgreSQL on 5432
POSTGRES_PORT=5432
