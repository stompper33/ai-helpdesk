# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# Paste your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Any model your account can use that supports structured outputs
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20

# auto   = use OpenAI when OPENAI_API_KEY is set, otherwise offline keyword rules
# openai = always OpenAI (fails at startup without a key)
# rules  = always offline keyword rules (free, no network)
AI_PROVIDER=auto

# Optional shared secret between Spring Boot and this service.
# If you set it here, set AI_SERVICE_API_KEY to the same value for helpdesk-api.
SERVICE_API_KEY=

# Stage 3: the reply-drafting agent calls helpdesk-api for its tools
HELPDESK_API_URL=http://localhost:8080
HELPDESK_API_TIMEOUT_SECONDS=10
# Leave empty to use OPENAI_MODEL
AGENT_MODEL=
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=30

# Stage 4: knowledge base (RAG). Without OPENAI_API_KEY, keyword search in memory is used.
# Locally (outside Docker), leave KNOWLEDGE_DB_URL empty to keep vectors in memory, or point it at
# the Docker database: postgresql://knowledge:knowledge@localhost:5432/knowledge
KNOWLEDGE_DB_URL=
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_TOP_K=4

LOG_LEVEL=INFO
